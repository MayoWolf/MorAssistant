<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.morassistant.backend</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>REPOSITORY_ROOT/scripts/local-deploy.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>REPOSITORY_ROOT</string>
  <key>StandardOutPath</key>
  <string>REPOSITORY_ROOT/data/backend.log</string>
  <key>StandardErrorPath</key>
  <string>REPOSITORY_ROOT/data/backend.error.log</string>
</dict>
</plist>
