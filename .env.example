# Web server
HOST=127.0.0.1
PORT=3000
# The exact panel origin, without a trailing slash.
APP_ORIGIN=http://127.0.0.1:5173
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-characters
# A separate key for AES-256-GCM encrypted session records.
# Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=replace-with-a-separate-high-entropy-secret
# Use /data/morassistant.sqlite on the persistent production volume.
SESSION_DB_PATH=./data/morassistant.sqlite
# A private per-installation token. Generate with: openssl rand -hex 32
INSTALLATION_TOKEN=

# Register these in Onshape Developer Portal / Developer Settings.
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
ONSHAPE_REDIRECT_URI=http://127.0.0.1:3000/oauth/onshape/callback
ONSHAPE_AUTHORIZATION_URL=https://oauth.onshape.com/oauth/authorize
ONSHAPE_TOKEN_URL=https://oauth.onshape.com/oauth/token
ONSHAPE_BASE_URL=https://cad.onshape.com
ONSHAPE_API_VERSION=v16
# Public FRCDesignApp catalog origin used to discover FRCDesignLib components.
FRC_DESIGN_BASE_URL=https://app.frcdesign.org

# Pin the CAD planner. MorAssistant verifies the actual app-server runtime and
# refuses to silently fall back when the configured model is unavailable.
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=high
CODEX_COMMAND=codex
CODEX_USERS_ROOT=./data/codex-users
CODEX_MAX_WORKERS=1
CODEX_IDLE_TIMEOUT_MS=900000

# Netlify/Vite build-time value. This is public in the browser bundle; never put
# secrets in a VITE_ variable. Omit for same-origin local development.
VITE_API_ORIGIN=
